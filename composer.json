{
    "name": "aaix/laravel-islands-search",
    "description": "A keyboard-driven global search modal built on Laravel Islands and Laravel Scout, with an optional Filament panel integration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "aaix/laravel-islands": "^1.0",
        "blade-ui-kit/blade-heroicons": "^2.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/scout": "^10.0|^11.0"
    },
    "suggest": {
        "filament/filament": "Mounts the search into Filament panels through IslandsSearchPlugin (^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Aaix\\LaravelIslandsSearch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aaix\\LaravelIslandsSearch\\IslandsSearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "filament/filament": "^5.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Aaix\\LaravelIslandsSearch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
